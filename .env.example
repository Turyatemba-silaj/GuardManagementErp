DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,guard-management-erp.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://guard-management-erp.vercel.app
DJANGO_SESSION_COOKIE_AGE=28800
DJANGO_ENABLE_ENV_SUPERUSER=false
DJANGO_HEALTHCHECK_TOKEN=replace-this-with-a-random-healthcheck-token

# PostgreSQL database. Set DATABASE_URL in Vercel Environment Variables.
DATABASE_URL=postgresql://postgres:replace-with-password@replace-with-host:5432/erp?sslmode=require

# Optional separate PostgreSQL variables when DATABASE_URL is not used.
DJANGO_DB_NAME=erp
DJANGO_DB_USER=postgres
DJANGO_DB_PASSWORD=replace-with-password
DJANGO_DB_HOST=replace-with-host
DJANGO_DB_PORT=5432
DJANGO_DB_SSLMODE=require

# Temporary local-only fallback. Keep false for live/production.
DJANGO_USE_SQLITE=false
DJANGO_DB_ENGINE=django.db.backends.sqlite3

DJANGO_MAX_UPLOAD_SIZE=5242880
DJANGO_MAX_EXCEL_UPLOAD_SIZE=5242880
ATTENDANCE_API_MAX_BODY_BYTES=32768

# Permanent app login. Keep disabled when login security is required.
ERP_PERMANENT_LOGIN=false
ERP_PERMANENT_LOGIN_USERNAME=admin
ERP_PERMANENT_LOGIN_PASSWORD=
ERP_PERMANENT_LOGIN_EMAIL=
ERP_PERMANENT_LOGIN_AGE=315360000

# Deployment bootstrap admin. Set these in Vercel Environment Variables.
DJANGO_SUPERUSER_USERNAME=replace-with-admin-username
DJANGO_SUPERUSER_PASSWORD=replace-with-a-long-random-password
DJANGO_SUPERUSER_EMAIL=admin@example.com
