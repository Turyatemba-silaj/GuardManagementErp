DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,guard-management-erp.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://guard-management-erp.vercel.app

# Local default is SQLite. For production, prefer PostgreSQL and set the values below.
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=db.sqlite3
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=

DJANGO_MAX_UPLOAD_SIZE=5242880
DJANGO_MAX_EXCEL_UPLOAD_SIZE=5242880
ATTENDANCE_API_MAX_BODY_BYTES=32768

# Permanent app login. Keep disabled when login security is required.
ERP_PERMANENT_LOGIN=false
ERP_PERMANENT_LOGIN_USERNAME=admin
ERP_PERMANENT_LOGIN_PASSWORD=
ERP_PERMANENT_LOGIN_EMAIL=
ERP_PERMANENT_LOGIN_AGE=315360000

# Deployment bootstrap admin. Set these in Vercel Environment Variables.
DJANGO_SUPERUSER_USERNAME=siraje
DJANGO_SUPERUSER_PASSWORD=siraje@2026
DJANGO_SUPERUSER_EMAIL=siraje@example.com
